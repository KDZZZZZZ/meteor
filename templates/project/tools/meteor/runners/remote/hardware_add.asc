#include <cstdint>
#include "kernel_operator.h"
using namespace AscendC;

extern "C" __global__ __aicore__ void meteor_hardware_add_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t n)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // Fixed aligned capability probe. GM scalar writes stay in per-core DataCache;
    // explicit GM/UB copies make the device output visible to the host verifier.
    const uint32_t blocks = GetBlockNum();
    if (blocks == 0 || n == 0 || n % blocks != 0) return;
    const uint32_t count = n / blocks;
    if (count % 8 != 0 || count > 2048) return;
    const uint32_t offset = GetBlockIdx() * count;
    GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x) + offset, count);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + offset, count);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z) + offset, count);
    TPipe pipe;
    TBuf<TPosition::VECCALC> xBuffer, yBuffer, zBuffer;
    pipe.InitBuffer(xBuffer, count * sizeof(float));
    pipe.InitBuffer(yBuffer, count * sizeof(float));
    pipe.InitBuffer(zBuffer, count * sizeof(float));
    auto xLocal = xBuffer.Get<float>();
    auto yLocal = yBuffer.Get<float>();
    auto zLocal = zBuffer.Get<float>();
    DataCopy(xLocal, xGm, count);
    DataCopy(yLocal, yGm, count);
    const auto inputReady = pipe.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(inputReady);
    WaitFlag<HardEvent::MTE2_V>(inputReady);
    Add(zLocal, xLocal, yLocal, count);
    const auto resultReady = pipe.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(resultReady);
    WaitFlag<HardEvent::V_MTE3>(resultReady);
    DataCopy(zGm, zLocal, count);
    const auto outputWritten = pipe.FetchEventID(HardEvent::MTE3_S);
    SetFlag<HardEvent::MTE3_S>(outputWritten);
    WaitFlag<HardEvent::MTE3_S>(outputWritten);
}
