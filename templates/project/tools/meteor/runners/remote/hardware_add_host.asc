#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"

#include "hardware_add.asc"

namespace {
constexpr uint32_t kElements = 256;

uint32_t ParseUInt(const char* value, uint32_t fallback)
{
    if (value == nullptr || value[0] == 0) return fallback;
    return static_cast<uint32_t>(std::strtoul(value, nullptr, 10));
}

void RequireAcl(aclError rc, const char* stage)
{
    if (rc != ACL_SUCCESS) {
        std::fprintf(stderr, "METEOR_HARDWARE_ADD_ACL_ERROR stage=%s rc=%d\n", stage, static_cast<int>(rc));
        throw std::runtime_error(stage);
    }
}

}  // namespace

int main(int argc, char** argv)
{
    int32_t device = argc >= 5 ? static_cast<int32_t>(ParseUInt(argv[4], 0)) : 0;
    uint32_t warmup = argc >= 6 ? ParseUInt(argv[5], 2) : 2;
    uint32_t repetitions = argc >= 7 ? ParseUInt(argv[6], 3) : 3;
    const size_t bytes = kElements * sizeof(float);
    bool initialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    float* hx = nullptr;
    float* hy = nullptr;
    float* hz = nullptr;
    void* dx = nullptr;
    void* dy = nullptr;
    void* dz = nullptr;
    int exitCode = 1;
    try {
        RequireAcl(aclInit(nullptr), "aclInit");
        initialized = true;
        RequireAcl(aclrtSetDevice(device), "aclrtSetDevice");
        deviceSet = true;
        RequireAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        RequireAcl(aclrtMallocHost(reinterpret_cast<void**>(&hx), bytes), "aclrtMallocHost_x");
        RequireAcl(aclrtMallocHost(reinterpret_cast<void**>(&hy), bytes), "aclrtMallocHost_y");
        RequireAcl(aclrtMallocHost(reinterpret_cast<void**>(&hz), bytes), "aclrtMallocHost_z");
        RequireAcl(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc_x");
        RequireAcl(aclrtMalloc(&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc_y");
        RequireAcl(aclrtMalloc(&dz, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc_z");
        for (uint32_t i = 0; i < kElements; ++i) {
            hx[i] = static_cast<float>(i) * 0.5f;
            hy[i] = 1000.0f - static_cast<float>(i) * 0.25f;
            hz[i] = -9999.0f;
        }
        RequireAcl(aclrtMemcpy(dx, bytes, hx, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy_x_h2d");
        RequireAcl(aclrtMemcpy(dy, bytes, hy, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy_y_h2d");
        RequireAcl(aclrtMemcpy(dz, bytes, hz, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy_z_h2d");
        for (uint32_t i = 0; i < warmup; ++i) {
            meteor_hardware_add_kernel<<<8, nullptr, stream>>>(reinterpret_cast<uint8_t*>(dx), reinterpret_cast<uint8_t*>(dy), reinterpret_cast<uint8_t*>(dz), kElements);
            RequireAcl(aclrtSynchronizeStreamWithTimeout(stream, 3000), "warmup_sync");
        }
        for (uint32_t i = 0; i < repetitions; ++i) {
            meteor_hardware_add_kernel<<<8, nullptr, stream>>>(reinterpret_cast<uint8_t*>(dx), reinterpret_cast<uint8_t*>(dy), reinterpret_cast<uint8_t*>(dz), kElements);
            RequireAcl(aclrtSynchronizeStreamWithTimeout(stream, 3000), "run_sync");
        }
        RequireAcl(aclrtMemcpy(hz, bytes, dz, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy_z_d2h");
        double maxAbs = 0.0;
        for (uint32_t i = 0; i < kElements; ++i) {
            const double expected = static_cast<double>(hx[i]) + static_cast<double>(hy[i]);
            const double error = std::fabs(static_cast<double>(hz[i]) - expected);
            if (error > maxAbs) maxAbs = error;
            if (!std::isfinite(hz[i]) || error > 1e-5) {
                std::fprintf(stderr, "METEOR_HARDWARE_ADD_MISMATCH index=%u got=%.9g expected=%.9g\n", i, hz[i], expected);
                throw std::runtime_error("incorrect add output");
            }
        }
        std::printf("METEOR_HARDWARE_ADD_PASS elements=%u repetitions=%u max_abs_error=%.9g\n", kElements, repetitions, maxAbs);
        exitCode = 0;
    } catch (const std::exception& exc) {
        std::fprintf(stderr, "METEOR_HARDWARE_ADD_FAIL device=%d message=%s\n", device, exc.what());
    }
    if (stream != nullptr) aclrtDestroyStream(stream);
    if (dx != nullptr) aclrtFree(dx);
    if (dy != nullptr) aclrtFree(dy);
    if (dz != nullptr) aclrtFree(dz);
    if (hx != nullptr) aclrtFreeHost(hx);
    if (hy != nullptr) aclrtFreeHost(hy);
    if (hz != nullptr) aclrtFreeHost(hz);
    if (deviceSet) aclrtResetDevice(device);
    if (initialized) aclFinalize();
    return exitCode;
}
