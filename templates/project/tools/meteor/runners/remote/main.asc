// Isolated meteor remote harness. Kernel source is supplied without rewriting it.
// It reports ACL event timing markers for run_kernel only:
//   QMQ_TIMING_US sample=<index> value=<microseconds>
#include <array>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <limits>
#include <stdexcept>
#include <string>
#include <sys/stat.h>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#ifndef QMQ_KERNEL_HEADER
#define QMQ_KERNEL_HEADER "kernel.asc"
#endif
#include QMQ_KERNEL_HEADER

namespace remote_harness {

uint64_t ParseUnsigned(const char* text, uint64_t limit, const char* name, bool allowZero)
{
    if (text == nullptr || *text == '\0') {
        throw std::runtime_error(std::string("missing ") + name);
    }
    for (const char* p = text; *p != '\0'; ++p) {
        if (*p < '0' || *p > '9') {
            throw std::runtime_error(std::string(name) + " must contain decimal digits only");
        }
    }
    errno = 0;
    char* end = nullptr;
    const unsigned long long value = std::strtoull(text, &end, 10);
    if (errno == ERANGE || *end != '\0' || value > limit || (!allowZero && value == 0)) {
        throw std::runtime_error(std::string(name) + " is out of range");
    }
    return static_cast<uint64_t>(value);
}

size_t CheckedProduct(size_t a, size_t b, const char* name)
{
    if (b != 0 && a > std::numeric_limits<size_t>::max() / b) {
        throw std::runtime_error(std::string("size_t overflow: ") + name);
    }
    const size_t size = a * b;
    if (size > static_cast<size_t>(std::numeric_limits<std::streamsize>::max())) {
        throw std::runtime_error(std::string("file length exceeds streamsize: ") + name);
    }
    return size;
}

bool CheckAcl(aclError rc, const char* stage, const char* tensor = "-")
{
    if (rc == 0) {
        return true;
    }
    std::fprintf(stderr, "QMQ_ACL_ERROR stage=%s tensor=%s rc=%lld\n",
        stage, tensor, static_cast<long long>(rc));
    return false;
}

void RequireAcl(aclError rc, const char* stage, const char* tensor = "-")
{
    if (!CheckAcl(rc, stage, tensor)) {
        throw std::runtime_error(std::string("ACL failure at ") + stage + " / " + tensor);
    }
}

void ReadExact(const std::string& path, uint8_t* target, size_t bytes)
{
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file || file.tellg() < 0 || static_cast<uint64_t>(file.tellg()) != bytes) {
        throw std::runtime_error("missing input or incorrect file size: " + path +
            " (expected " + std::to_string(bytes) + " bytes)");
    }
    file.seekg(0, std::ios::beg);
    if (!file.read(reinterpret_cast<char*>(target), static_cast<std::streamsize>(bytes))) {
        throw std::runtime_error("input read failed: " + path);
    }
}

void EnsureOutputDirectory()
{
    if (::mkdir("output", 0755) != 0 && errno != EEXIST) {
        throw std::runtime_error(std::string("mkdir output failed: ") + std::strerror(errno));
    }
    struct stat info {};
    if (::stat("output", &info) != 0 || !S_ISDIR(info.st_mode)) {
        throw std::runtime_error("output exists but is not a directory");
    }
}

void WriteExact(const std::string& path, const uint8_t* data, size_t bytes)
{
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file || !file.write(reinterpret_cast<const char*>(data), static_cast<std::streamsize>(bytes))) {
        throw std::runtime_error("output write failed: " + path);
    }
    file.close();
    if (!file) {
        throw std::runtime_error("output close failed: " + path);
    }
}

struct Buffer {
    const char* name;
    size_t bytes;
    uint8_t* host = nullptr;
    uint8_t* device = nullptr;
    Buffer(const char* nameIn, size_t bytesIn) : name(nameIn), bytes(bytesIn) {}
};

} // namespace remote_harness

int main(int argc, char** argv)
{
    using namespace remote_harness;
    if (argc < 4 || argc > 7) {
        std::fprintf(stderr, "Usage: %s M N K [device=0] [warmup=3] [repetitions=5]\nReads ./input/*.bin; writes ./output/{y,yScale}.bin\n", argv[0]);
        return 2;
    }
    uint32_t m = 0, n = 0, k = 0;
    int32_t deviceId = 0;
    uint32_t warmup = 3, repetitions = 5;
    size_t aBytes = 0, bBytes = 0, tokenBytes = 0, channelBytes = 0, yBytes = 0;
    try {
        m = static_cast<uint32_t>(ParseUnsigned(argv[1], UINT32_MAX, "M", false));
        n = static_cast<uint32_t>(ParseUnsigned(argv[2], UINT32_MAX, "N", false));
        k = static_cast<uint32_t>(ParseUnsigned(argv[3], UINT32_MAX, "K", false));
        if (argc >= 5) deviceId = static_cast<int32_t>(ParseUnsigned(argv[4], INT32_MAX, "device", true));
        if (argc >= 6) warmup = static_cast<uint32_t>(ParseUnsigned(argv[5], 1000, "warmup", true));
        if (argc >= 7) repetitions = static_cast<uint32_t>(ParseUnsigned(argv[6], 1000, "repetitions", false));
        aBytes = CheckedProduct(m, k, "M*K");
        bBytes = CheckedProduct(n, k, "N*K");
        tokenBytes = CheckedProduct(m, sizeof(float), "M*sizeof(float)");
        channelBytes = CheckedProduct(n, sizeof(float), "N*sizeof(float)");
        yBytes = CheckedProduct(m, n, "M*N");
        (void)CheckedProduct(yBytes, sizeof(int32_t), "internal M*N*sizeof(int32_t)");
    } catch (const std::exception& error) {
        std::fprintf(stderr, "QMQ_ARGUMENT_ERROR %s\n", error.what());
        return 2;
    }

    std::array<Buffer, 6> buffers{{Buffer("x1", aBytes), Buffer("x2", bBytes),
        Buffer("x1Scale", tokenBytes), Buffer("x2Scale", channelBytes),
        Buffer("y", yBytes), Buffer("yScale", tokenBytes)}};
    bool initialized = false, deviceSet = false;
    aclrtStream stream = nullptr;
    int64_t availableCoreNum = 0;
    int result = 1;
    try {
        EnsureOutputDirectory();
        RequireAcl(aclInit(nullptr), "aclInit");
        initialized = true;
        RequireAcl(aclrtSetDevice(deviceId), "aclrtSetDevice");
        deviceSet = true;
        RequireAcl(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum), "aclrtGetDeviceInfo");
        if (availableCoreNum <= 0) {
            throw std::runtime_error("ACL reported nonpositive available Cube core count");
        }
        RequireAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        for (size_t i = 0; i < buffers.size(); ++i) {
            Buffer& buffer = buffers[i];
            RequireAcl(aclrtMallocHost(reinterpret_cast<void**>(&buffer.host), buffer.bytes), "aclrtMallocHost", buffer.name);
            RequireAcl(aclrtMalloc(reinterpret_cast<void**>(&buffer.device), buffer.bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc", buffer.name);
            if (i < 4) {
                ReadExact(std::string("input/") + buffer.name + ".bin", buffer.host, buffer.bytes);
                RequireAcl(aclrtMemcpy(buffer.device, buffer.bytes, buffer.host, buffer.bytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy_H2D", buffer.name);
            } else {
                RequireAcl(aclrtMemset(buffer.device, buffer.bytes, i == 4 ? 0xA5 : 0xFF, buffer.bytes), "aclrtMemset_output", buffer.name);
            }
        }

        int64_t aShape[] = {m, k}, bShape[] = {n, k};
        int64_t tokenShape[] = {m}, channelShape[] = {n}, yShape[] = {m, n};
        TensorInfo aInfo{aShape, 2, 3}, bInfo{bShape, 2, 3};
        TensorInfo tokenInfo{tokenShape, 1, 0}, channelInfo{channelShape, 1, 0};
        TensorInfo yInfo{yShape, 2, 3}, yScaleInfo{tokenShape, 1, 0};
        TensorGroupInfo aGroup{&aInfo, 1}, bGroup{&bInfo, 1};
        TensorGroupInfo tokenGroup{&tokenInfo, 1}, channelGroup{&channelInfo, 1};
        TensorGroupInfo yGroup{&yInfo, 1}, yScaleGroup{&yScaleInfo, 1};
        std::fprintf(stderr, "QMQ_RUN M=%u N=%u K=%u device=%d availableCubeCores=%lld warmup=%u repetitions=%u\n",
            m, n, k, deviceId, static_cast<long long>(availableCoreNum), warmup, repetitions);

        const auto invoke = [&]() {
            run_kernel((GM_ADDR)buffers[0].device, aGroup, (GM_ADDR)buffers[1].device, bGroup,
                (GM_ADDR)buffers[2].device, tokenGroup, (GM_ADDR)buffers[3].device, channelGroup,
                (GM_ADDR)buffers[4].device, yGroup, (GM_ADDR)buffers[5].device, yScaleGroup,
                availableCoreNum, stream);
        };
        for (uint32_t i = 0; i < warmup; ++i) {
            invoke();
            RequireAcl(aclrtSynchronizeStreamWithTimeout(stream, 3000), "warmup_synchronize");
        }
        for (uint32_t i = 0; i < repetitions; ++i) {
            aclrtEvent start = nullptr;
            aclrtEvent stop = nullptr;
            RequireAcl(aclrtCreateEvent(&start), "aclrtCreateEvent_start");
            RequireAcl(aclrtCreateEvent(&stop), "aclrtCreateEvent_stop");
            RequireAcl(aclrtRecordEvent(start, stream), "aclrtRecordEvent_start");
            invoke();
            RequireAcl(aclrtRecordEvent(stop, stream), "aclrtRecordEvent_stop");
            RequireAcl(aclrtSynchronizeEvent(stop), "aclrtSynchronizeEvent_stop");
            float elapsedMs = 0.0F;
            RequireAcl(aclrtEventElapsedTime(&elapsedMs, start, stop), "aclrtEventElapsedTime");
            std::printf("QMQ_TIMING_US sample=%u value=%.3f\n", i, static_cast<double>(elapsedMs) * 1000.0);
            std::fflush(stdout);
            if (!CheckAcl(aclrtDestroyEvent(start), "aclrtDestroyEvent_start")) result = 1;
            if (!CheckAcl(aclrtDestroyEvent(stop), "aclrtDestroyEvent_stop")) result = 1;
        }
        RequireAcl(aclrtSynchronizeStreamWithTimeout(stream, 3000), "post_run_synchronize");
        for (size_t i = 4; i < buffers.size(); ++i) {
            Buffer& buffer = buffers[i];
            RequireAcl(aclrtMemcpy(buffer.host, buffer.bytes, buffer.device, buffer.bytes, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy_D2H", buffer.name);
            WriteExact(std::string("output/") + buffer.name + ".bin", buffer.host, buffer.bytes);
        }
        result = 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "QMQ_HOST_ERROR M=%u N=%u K=%u device=%d message=%s\n", m, n, k, deviceId, error.what());
    } catch (...) {
        std::fprintf(stderr, "QMQ_HOST_ERROR unknown exception\n");
    }

    for (Buffer& buffer : buffers) {
        if (buffer.device && !CheckAcl(aclrtFree(buffer.device), "aclrtFree", buffer.name)) result = 1;
        if (buffer.host && !CheckAcl(aclrtFreeHost(buffer.host), "aclrtFreeHost", buffer.name)) result = 1;
    }
    if (stream && !CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream")) result = 1;
    if (deviceSet && !CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice")) result = 1;
    if (initialized && !CheckAcl(aclFinalize(), "aclFinalize")) result = 1;
    if (result == 0) std::fprintf(stderr, "QMQ_RUN_COMPLETE outputs_written=2\n");
    return result;
}
