enum class MeteorStatus : uint32_t {
    Success = 0,
    InvalidInput = 1,
    Unsupported = 2,
    ResourceRejected = 3,
    LaunchFailed = 4,
};

enum class MeteorTracePhase : uint32_t {
    Selected = 0,
    Finished = 1,
    Rejected = 2,
};

struct MeteorCall {
    GM_ADDR x1;
