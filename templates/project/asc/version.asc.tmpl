};

// Diagnostic builds must supply a recorder through the host harness.
// Performance builds have no route recorder calls.
#if defined(METEOR_ENABLE_ROUTE_TRACE) && !defined(METEOR_ROUTE_TRACE)
#error "METEOR_ROUTE_TRACE is required when route diagnostics are enabled"
#endif

static inline void meteor_report_route(
    MeteorTracePhase phase, MeteorChoice choice, MeteorStatus status)
{
#if defined(METEOR_ENABLE_ROUTE_TRACE)
    METEOR_ROUTE_TRACE(static_cast<uint32_t>(phase), choice.ruleId,
        choice.implementationId, static_cast<uint32_t>(status));
#else
    (void)phase;
    (void)choice;
    (void)status;
#endif
}

