extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo& info_x1,
    GM_ADDR x2,
    const TensorGroupInfo& info_x2,
    GM_ADDR x1Scale,
    const TensorGroupInfo& info_x1Scale,
    GM_ADDR x2Scale,
    const TensorGroupInfo& info_x2Scale,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR yScale,
    const TensorGroupInfo& info_yScale,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const MeteorCall call{
        x1, info_x1, x2, info_x2, x1Scale, info_x1Scale,
        x2Scale, info_x2Scale, y, info_y, yScale, info_yScale,
        availableCoreNum, stream,
    };
    MeteorShape shape{};
    MeteorResources resources{};
    const MeteorStatus inputStatus = meteor_describe_call(call, shape, resources);
    if (inputStatus != MeteorStatus::Success) {
        meteor_report_route(MeteorTracePhase::Rejected, {0U, 0U}, inputStatus);
        return;
    }

    const MeteorChoice choice = meteor_choose_kernel(shape, resources, availableCoreNum);
    if (choice.implementationId == 0U) {
        meteor_report_route(MeteorTracePhase::Rejected, choice, MeteorStatus::Unsupported);
        return;
    }

    meteor_report_route(MeteorTracePhase::Selected, choice, MeteorStatus::Success);
    MeteorStatus status = MeteorStatus::Unsupported;
    switch (choice.implementationId) {
        // Generated case arms call the corresponding module's host launcher.
        // Every case terminates with break; no fall-through or fallback route.
        {{DISPATCH_CASES}}
        default:
            break;
    }
    meteor_report_route(MeteorTracePhase::Finished, choice, status);
}
